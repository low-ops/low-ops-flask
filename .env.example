DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=people_desk

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket only, or bucket/prefix (e.g. apps-cinaq-dev-bucket/flask-app-dev)
S3_BUCKET_NAME=
# Full URL or host (https:// is added when missing)
S3_ENDPOINT=
# Mendix storage type (com.mendix.storage.s3). Not used as AWS region.
S3_SERVICE_NAME=com.mendix.storage.s3
# Optional AWS region override. Otherwise derived from endpoint, else us-east-1.
S3_REGION=
S3_PERFORM_DELETE=true
